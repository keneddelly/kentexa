/**
 * AgentEarnings.js — Agent Earnings History Page
 * Place at: src/public/pages/AgentEarnings.js
 *
 * Shows agent's complete earnings breakdown:
 * - Total earned (all time)
 * - This week / this month
 * - Per-delivery breakdown
 * - Payment collection earnings
 * - Collection earnings
 */
import React, { useState, useEffect } from 'react';
import BackBar from '../components/BackBar';
import api from '../../api/api';

const fmt = (n) => Number(n || 0).toLocaleString();

const StatCard = ({ label, value, sub, color, bg, icon }) => (
  <div style={{ backgroundColor: bg || '#fff', borderRadius: 14, padding: 16,
    boxShadow: '0 2px 8px rgba(0,0,0,0.06)', flex: 1 }}>
    <div style={{ fontSize: 22 }}>{icon}</div>
    <div style={{ fontSize: 18, fontWeight: 900, color: color || '#1e293b', marginTop: 6 }}>
      TZS {value}
    </div>
    <div style={{ fontSize: 11, color: '#64748b', marginTop: 2, fontWeight: 600 }}>{label}</div>
    {sub && <div style={{ fontSize: 10, color: '#94a3b8', marginTop: 2 }}>{sub}</div>}
  </div>
);

const EarningsBar = ({ orders }) => {
  // Last 7 days bar chart (SVG)
  const days = Array.from({ length: 7 }, (_, i) => {
    const d = new Date();
    d.setDate(d.getDate() - (6 - i));
    return {
      label:    d.toLocaleDateString('sw-TZ', { weekday: 'short' }),
      key:      d.toISOString().slice(0, 10),
      earnings: 0, count: 0,
    };
  });

  (orders || []).forEach(o => {
    const day = (o.createdAt || o.updatedAt)?.slice(0, 10);
    const d   = days.find(d => d.key === day);
    if (d) {
      d.earnings += Number(o.agentCommissionAmount || o.deliveryFeeAmount || 0);
      d.count    += 1;
    }
  });

  const maxE = Math.max(...days.map(d => d.earnings), 1);
  const W = 300, H = 90, BAR_W = 28, GAP = 14;
  const totalW = days.length * (BAR_W + GAP) - GAP;
  const startX = (W - totalW) / 2;

  return (
    <div style={{ backgroundColor: '#fff', borderRadius: 16, padding: 20,
      boxShadow: '0 2px 8px rgba(0,0,0,0.06)', marginBottom: 16 }}>
      <div style={{ fontSize: 14, fontWeight: 900, color: '#1e293b', marginBottom: 14 }}>
        📊 Mapato — Wiki Hii
      </div>
      <svg width="100%" viewBox={`0 0 ${W} ${H + 24}`}>
        <defs>
          <linearGradient id="earnGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="#16a34a" />
            <stop offset="100%" stopColor="#059669" />
          </linearGradient>
        </defs>
        {days.map((day, i) => {
          const x    = startX + i * (BAR_W + GAP);
          const barH = day.earnings > 0 ? Math.max(6, (day.earnings / maxE) * H) : 4;
          const y    = H - barH;
          const isToday = i === 6;
          return (
            <g key={day.key}>
              <rect x={x} y={y} width={BAR_W} height={barH} rx={5}
                fill={isToday ? 'url(#earnGrad)' : '#dcfce7'} />
              {isToday && day.earnings > 0 && (
                <text x={x + BAR_W / 2} y={y - 5} textAnchor="middle"
                  fontSize={8} fill="#16a34a" fontWeight="700">
                  {(day.earnings / 1000).toFixed(0)}k
                </text>
              )}
              <text x={x + BAR_W / 2} y={H + 20} textAnchor="middle"
                fontSize={9} fill={isToday ? '#16a34a' : '#94a3b8'}
                fontWeight={isToday ? '800' : '400'}>
                {day.label}
              </text>
            </g>
          );
        })}
        <line x1={startX - 4} y1={H} x2={startX + totalW + 4} y2={H}
          stroke="#f1f5f9" strokeWidth={1} />
      </svg>
    </div>
  );
};

const AgentEarnings = ({ onNavigate }) => {
  const [orders,   setOrders]   = useState([]);
  const [stats,    setStats]    = useState(null);
  const [payStats, setPayStats] = useState(null);
  const [agentProfile, setAgentProfile] = useState(null);
  const [loading,  setLoading]  = useState(true);
  const [tab,      setTab]      = useState('deliveries'); // deliveries | payments | collections

  useEffect(() => {
    Promise.all([
      api.get('/agents/my-profile'),
      api.get('/agent-orders/my-orders'),
      api.get('/agent-orders/stats'),
      api.get('/payments/agent/dashboard').catch(() => ({ data: null })),
    ]).then(([profileRes, ordersRes, statsRes, payRes]) => {
      setAgentProfile(profileRes.data);
      setOrders(ordersRes.data || []);
      setStats(statsRes.data);
      setPayStats(payRes.data);
    }).catch(() => {})
      .finally(() => setLoading(false));
  }, []);

  if (loading) return (
    <div style={{ minHeight: '100vh', backgroundColor: '#f8fafc' }}>
      <BackBar title="Mapato Yangu" onBack={() => onNavigate('back')} />
      <div style={{ textAlign: 'center', padding: 60, color: '#94a3b8' }}>
        <div style={{ fontSize: 40, marginBottom: 12 }}>💰</div>
        <div>Inapakia mapato...</div>
      </div>
    </div>
  );

  const deliveries     = orders.filter(o => o.status === 'delivered' || o.status === 'completed');
  const totalDelivery  = deliveries.reduce((s, o) =>
    s + Number(o.agentCommissionAmount || o.deliveryFeeAmount || 0), 0);

  const now        = new Date();
  const weekStart  = new Date(now); weekStart.setDate(now.getDate() - 7);
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);

  const weekOrders  = deliveries.filter(o => new Date(o.updatedAt || o.createdAt) >= weekStart);
  const monthOrders = deliveries.filter(o => new Date(o.updatedAt || o.createdAt) >= monthStart);

  const weekEarnings  = weekOrders.reduce((s, o) =>
    s + Number(o.agentCommissionAmount || o.deliveryFeeAmount || 0), 0);
  const monthEarnings = monthOrders.reduce((s, o) =>
    s + Number(o.agentCommissionAmount || o.deliveryFeeAmount || 0), 0);

  const totalPayments  = Number(payStats?.totalEarnings || agentProfile?.totalEarningsPayments || 0);
  const totalCollections = Number(agentProfile?.totalEarningsCollections || 0);
  const grandTotal     = totalDelivery + totalPayments + totalCollections;

  return (
    <div style={{ minHeight: '100vh', backgroundColor: '#f8fafc' }}>
      <BackBar title="Mapato Yangu" onBack={() => onNavigate('back')} />

      <div style={{ maxWidth: 480, margin: '0 auto', padding: '16px 16px 80px' }}>

        {/* Grand total hero */}
        <div style={{ background: 'linear-gradient(135deg,#16a34a,#059669)',
          borderRadius: 20, padding: 24, marginBottom: 20, textAlign: 'center' }}>
          <div style={{ fontSize: 13, color: 'rgba(255,255,255,0.8)',
            fontWeight: 700, marginBottom: 6 }}>JUMLA YA MAPATO YOTE</div>
          <div style={{ fontSize: 32, fontWeight: 900, color: '#fff' }}>
            TZS {fmt(grandTotal)}
          </div>
          <div style={{ display: 'flex', justifyContent: 'center', gap: 20, marginTop: 14 }}>
            <div style={{ textAlign: 'center' }}>
              <div style={{ fontSize: 15, fontWeight: 900, color: '#fff' }}>
                TZS {fmt(weekEarnings)}
              </div>
              <div style={{ fontSize: 10, color: 'rgba(255,255,255,0.7)' }}>Wiki Hii</div>
            </div>
            <div style={{ width: 1, backgroundColor: 'rgba(255,255,255,0.3)' }} />
            <div style={{ textAlign: 'center' }}>
              <div style={{ fontSize: 15, fontWeight: 900, color: '#fff' }}>
                TZS {fmt(monthEarnings)}
              </div>
              <div style={{ fontSize: 10, color: 'rgba(255,255,255,0.7)' }}>Mwezi Huu</div>
            </div>
            <div style={{ width: 1, backgroundColor: 'rgba(255,255,255,0.3)' }} />
            <div style={{ textAlign: 'center' }}>
              <div style={{ fontSize: 15, fontWeight: 900, color: '#fff' }}>
                {deliveries.length}
              </div>
              <div style={{ fontSize: 10, color: 'rgba(255,255,255,0.7)' }}>Matoleo</div>
            </div>
          </div>
        </div>

        {/* Stats row */}
        <div style={{ display: 'flex', gap: 10, marginBottom: 16 }}>
          <StatCard icon="🚚" label="Utoaji" value={fmt(totalDelivery)}
            color="#1d4ed8" bg="#eff6ff"
            sub={`${deliveries.length} matoleo`} />
          <StatCard icon="💳" label="Malipo" value={fmt(totalPayments)}
            color="#7c3aed" bg="#f5f3ff"
            sub={`${payStats?.totalTransactions || 0} malipo`} />
          <StatCard icon="📦" label="Ukusanyaji" value={fmt(totalCollections)}
            color="#16a34a" bg="#f0fdf4"
            sub={`${agentProfile?.totalCollectionsCompleted || 0} vifurushi`} />
        </div>

        {/* Weekly chart */}
        <EarningsBar orders={deliveries} />

        {/* Tabs */}
        <div style={{ display: 'flex', backgroundColor: '#fff', borderRadius: 12,
          padding: 4, marginBottom: 16, boxShadow: '0 1px 4px rgba(0,0,0,0.06)' }}>
          {[
            { key: 'deliveries', label: '🚚 Utoaji' },
            { key: 'payments',   label: '💳 Malipo' },
          ].map(t => (
            <button key={t.key} onClick={() => setTab(t.key)}
              style={{ flex: 1, padding: '9px 8px', border: 'none', cursor: 'pointer',
                borderRadius: 9, fontSize: 12, fontWeight: 700,
                backgroundColor: tab === t.key ? '#1d4ed8' : 'transparent',
                color: tab === t.key ? '#fff' : '#64748b' }}>
              {t.label}
            </button>
          ))}
        </div>

        {/* Deliveries tab */}
        {tab === 'deliveries' && (
          <div>
            {deliveries.length === 0 ? (
              <div style={{ textAlign: 'center', padding: 40, color: '#94a3b8' }}>
                <div style={{ fontSize: 36, marginBottom: 10 }}>🚚</div>
                <div>Bado hujatoa bidhaa yoyote</div>
              </div>
            ) : (
              deliveries.slice(0, 30).map(o => {
                const fee = Number(o.agentCommissionAmount || o.deliveryFeeAmount || 0);
                const date = new Date(o.updatedAt || o.createdAt)
                  .toLocaleDateString('sw-TZ', { day: 'numeric', month: 'short' });
                return (
                  <div key={o.id} style={{ backgroundColor: '#fff', borderRadius: 12,
                    padding: '12px 14px', marginBottom: 8,
                    display: 'flex', alignItems: 'center', gap: 12,
                    boxShadow: '0 1px 4px rgba(0,0,0,0.04)' }}>
                    <div style={{ width: 40, height: 40, borderRadius: 10,
                      backgroundColor: '#f0fdf4', display: 'flex',
                      alignItems: 'center', justifyContent: 'center',
                      fontSize: 18, flexShrink: 0 }}>🚚</div>
                    <div style={{ flex: 1, minWidth: 0 }}>
                      <div style={{ fontSize: 13, fontWeight: 700, color: '#1e293b',
                        overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                        {o.product?.name || o.manualProductName || o.description || `Agizo #${o.id}`}
                      </div>
                      <div style={{ fontSize: 11, color: '#64748b', marginTop: 2 }}>
                        {o.buyer?.name || o.manualBuyerName || o.recipientName || '—'} · {date}
                      </div>
                    </div>
                    <div style={{ textAlign: 'right', flexShrink: 0 }}>
                      <div style={{ fontSize: 14, fontWeight: 900, color: '#16a34a' }}>
                        +{fmt(fee)}
                      </div>
                      <div style={{ fontSize: 10, color: '#94a3b8' }}>TZS</div>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        )}

        {/* Payments tab */}
        {tab === 'payments' && (
          <div style={{ textAlign: 'center', padding: 40 }}>
            <div style={{ fontSize: 40, marginBottom: 12 }}>💳</div>
            <div style={{ fontSize: 22, fontWeight: 900, color: '#1e293b', marginBottom: 8 }}>
              TZS {fmt(totalPayments)}
            </div>
            <div style={{ fontSize: 13, color: '#64748b', marginBottom: 20 }}>
              Mapato kutoka ukusanyaji wa malipo
            </div>
            {payStats && (
              <div style={{ backgroundColor: '#f5f3ff', borderRadius: 14, padding: 16,
                textAlign: 'left' }}>
                {[
                  ['Jumla ya Miamala', payStats.totalTransactions || 0],
                  ['Jumla Iliyokusanywa', `TZS ${fmt(payStats.totalCollected)}`],
                  ['Asilimia ya Faida', `${payStats.commissionRate || 1}%`],
                ].map(([l, v]) => (
                  <div key={l} style={{ display: 'flex', justifyContent: 'space-between',
                    padding: '8px 0', borderBottom: '1px solid rgba(124,58,237,0.1)',
                    fontSize: 13 }}>
                    <span style={{ color: '#64748b' }}>{l}</span>
                    <span style={{ fontWeight: 700, color: '#7c3aed' }}>{v}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {/* Pending earnings notice */}
        {Number(agentProfile?.pendingEarnings || 0) > 0 && (
          <div style={{ backgroundColor: '#fef3c7', borderRadius: 14, padding: 16,
            marginTop: 16, display: 'flex', gap: 12, alignItems: 'center' }}>
            <div style={{ fontSize: 28 }}>⏳</div>
            <div>
              <div style={{ fontSize: 13, fontWeight: 800, color: '#92400e' }}>
                Mapato Yanayosubiri Kutolewa
              </div>
              <div style={{ fontSize: 18, fontWeight: 900, color: '#d97706', marginTop: 2 }}>
                TZS {fmt(agentProfile.pendingEarnings)}
              </div>
              <div style={{ fontSize: 11, color: '#92400e', marginTop: 2 }}>
                Yatatoka baada ya admin kuidhinisha
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  );
};

export default AgentEarnings;